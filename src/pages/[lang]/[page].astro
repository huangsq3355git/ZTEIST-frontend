---
import Layout from '../../layouts/Layout.astro'
import { t, type Lang } from '../../i18n'

export function getStaticPaths() {
  const langs = ['zh', 'en']
  const pages = ['join', 'privacy', 'terms', 'faq', 'contact']
  return langs.flatMap((lang) => pages.map((page) => ({ params: { lang, page } })))
}

const { lang, page } = Astro.params as { lang: string; page: string }
const l = lang as Lang
const i = t(l)
const titles: Record<string, string> = {
  about: i.about,
  join: i.join,
  privacy: i.privacy,
  terms: i.terms,
  faq: i.faq,
  contact: i.contact,
}
const title = titles[page] || page
---
<Layout title={`${title} | ${i.brand}`} lang={l}>
  <h1 class="text-2xl font-bold mb-4 text-zte-navy">{title}</h1>
  <p class="text-gray-500">{i.loading}</p>
</Layout>
