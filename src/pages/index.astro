---
import Layout from '../layouts/Layout.astro'
---
<Layout title="中友会" lang="zh">
  <style>
    @keyframes fireIn {
      0% { opacity: 0; transform: scale(0.92); filter: blur(6px); }
      100% { opacity: 1; transform: scale(1); filter: blur(0); }
    }
    @keyframes starIn {
      0% { opacity: 0; transform: translateY(16px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .anim-fire { animation: fireIn 1.1s ease both; }
    .anim-star { animation: starIn 0.9s ease 1.5s both; }
    .anim-later { animation: starIn 0.9s ease 2.1s both; }
  </style>

  <!-- 标语动画 → 吉祥物显现 -->
  <section class="flex flex-col items-center text-center pt-12 pb-8">
    <h1 class="anim-fire font-serif text-3xl font-bold leading-relaxed">
      <span class="text-zte-red">聚是一团火</span>，<span class="text-zte-blue">散是满天星</span>
    </h1>

    <img src="/mascot.png?v=2" alt="小Z" class="anim-star h-28 w-28 mt-6 object-contain" />

    <p class="anim-star text-gray-600 mt-4">你好，我是中友会助手小Z</p>

    <form action="/zh/people/" method="get" class="anim-later w-full max-w-sm mt-5">
      <div class="flex gap-2">
        <input
          type="text"
          name="q"
          placeholder="搜索老同事…"
          class="flex-1 border border-gray-300 rounded-full px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-jade"
        />
        <button type="submit" class="bg-jade text-ink px-5 py-2 rounded-full text-sm font-medium hover:opacity-90 shrink-0">搜索</button>
      </div>
    </form>
  </section>

  <!-- 功能模块卡片 -->
  <section class="anim-later grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-3xl mx-auto">
    <a href="/zh/people/" class="block rounded-xl border-2 border-zte-blue bg-white p-4 text-center hover:shadow-md transition-shadow">
      <span class="block text-2xl">👥</span>
      <span class="block mt-2 font-semibold text-zte-navy">人员</span>
      <span class="block text-xs text-gray-500">找老同事</span>
    </a>
    <a href="/zh/market/" class="block rounded-xl border-2 border-zte-red bg-white p-4 text-center hover:shadow-md transition-shadow">
      <span class="block text-2xl">🤝</span>
      <span class="block mt-2 font-semibold text-zte-navy">供求</span>
      <span class="block text-xs text-gray-500">供需对接</span>
    </a>
    <a href="/zh/projects/" class="block rounded-xl border-2 border-zte-navy bg-white p-4 text-center hover:shadow-md transition-shadow">
      <span class="block text-2xl">📋</span>
      <span class="block mt-2 font-semibold text-zte-navy">项目</span>
      <span class="block text-xs text-gray-500">项目合作</span>
    </a>
    <div class="block rounded-xl border-2 border-gray-200 bg-white p-4 text-center opacity-70">
      <span class="block text-2xl">🔍</span>
      <span class="block mt-2 font-semibold text-zte-navy">背景调查</span>
      <span class="block text-xs text-gray-400">即将上线</span>
    </div>
  </section>
</Layout>
