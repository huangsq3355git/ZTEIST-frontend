---
import Layout from '../layouts/Layout.astro'
---
<Layout title="中友会" lang="zh">
  <style>
    @keyframes fireIn {
      0% { opacity: 0; transform: scale(0.92); filter: blur(6px); }
      100% { opacity: 1; transform: scale(1); filter: blur(0); }
    }
    @keyframes starIn {
      0% { opacity: 0; transform: translateY(16px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .anim-fire { animation: fireIn 1.1s ease both; }
    .anim-star { animation: starIn 0.9s ease 1.4s both; }
    .anim-later { animation: starIn 0.9s ease 2s both; }
  </style>

  <!-- 标语动画 → 小Z 居中显现 -->
  <section class="flex flex-col items-center text-center pt-10 pb-5">
    <h1 class="anim-fire font-serif text-3xl font-bold leading-relaxed">
      <span class="text-zte-red">聚是一团火</span>，<span class="text-zte-blue">散是满天星</span>
    </h1>
    <img src="/mascot.png?v=2" alt="小Z" class="anim-star h-32 w-32 mt-5 object-contain" />
  </section>

  <!-- 功能模块键：小Z 脚下 -->
  <section class="anim-later grid grid-cols-2 gap-3 sm:grid-cols-4 max-w-md mx-auto px-4">
    <a href="/zh/people/" class="rounded-xl border-2 border-zte-blue bg-white py-4 text-center hover:shadow-md transition-shadow">
      <span class="block text-2xl">👥</span>
      <span class="block mt-1 text-sm font-semibold text-zte-navy">人员</span>
    </a>
    <a href="/zh/market/" class="rounded-xl border-2 border-zte-red bg-white py-4 text-center hover:shadow-md transition-shadow">
      <span class="block text-2xl">🤝</span>
      <span class="block mt-1 text-sm font-semibold text-zte-navy">供求</span>
    </a>
    <a href="/zh/projects/" class="rounded-xl border-2 border-zte-navy bg-white py-4 text-center hover:shadow-md transition-shadow">
      <span class="block text-2xl">📋</span>
      <span class="block mt-1 text-sm font-semibold text-zte-navy">项目</span>
    </a>
    <div class="rounded-xl border-2 border-gray-200 bg-white py-4 text-center opacity-70">
      <span class="block text-2xl">🔍</span>
      <span class="block mt-1 text-sm font-semibold text-zte-navy">背景调查</span>
    </div>
  </section>

  <!-- 小搜索条（次要） -->
  <section class="anim-later max-w-sm mx-auto mt-6 px-4">
    <form action="/zh/people/" method="get">
      <div class="flex gap-2">
        <input
          type="text"
          name="q"
          placeholder="搜索老同事…"
          class="flex-1 border border-gray-300 rounded-full px-4 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-jade"
        />
        <button type="submit" class="bg-jade text-ink px-4 py-1.5 rounded-full text-sm font-medium hover:opacity-90 shrink-0">搜索</button>
      </div>
    </form>
  </section>
</Layout>
