---
import '../styles/global.css'
import '../styles/animations.css'
import { t, type Lang } from '../i18n'
import FloatingZ from '../components/FloatingZ.tsx'
import AuthNav from '../components/AuthNav.tsx'
import InstallPwa from '../components/InstallPwa.astro'

interface Props {
  title: string
  lang?: Lang
}
const { title, lang = 'zh' } = Astro.props
const i = t(lang)
const prefix = lang === 'en' ? '/en' : '/zh'

const footerLinks = [
  { href: `${prefix}/about/`, label: i.about },
  { href: `${prefix}/join/`, label: i.join },
  { href: `${prefix}/privacy/`, label: i.privacy },
  { href: `${prefix}/terms/`, label: i.terms },
  { href: `${prefix}/faq/`, label: i.faq },
  { href: `${prefix}/contact/`, label: i.contact },
]

// 语言切换：语言页换 /zh ↔ /en；首页(/、/en/)/邀请页切到对应语言首页
const path = Astro.url.pathname
const alt = (to: 'zh' | 'en') => {
  if (path === '/' || path === '/en/') return to === 'zh' ? '/' : '/en/'
  if (path.startsWith('/zh/') || path.startsWith('/en/')) return path.replace(/^\/(zh|en)/, '/' + to)
  return to === 'zh' ? '/' : '/en/'
}
const zhHref = alt('zh')
const enHref = alt('en')
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#002544" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-pwa.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <!-- 机器面：JSON-LD 结构化数据，让 AI 爬虫读懂平台与服务 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        { '@type': 'Organization', 'name': 'ZTEIST 中友会', 'alternateName': 'ZTEIST', 'url': 'https://zteist.com', 'description': '中友会·同事录/校友录社区——中兴系 30 万+ 离职人才网络，覆盖 100+ 国家' },
        { '@type': 'WebSite', 'name': 'ZTEIST 中友会', 'url': 'https://zteist.com', 'potentialAction': { '@type': 'SearchAction', 'target': 'https://zteist.com/zh/people/?q={search_term_string}', 'query-input': 'required name=search_term_string' } },
        { '@type': 'Service', 'name': '人员', 'serviceType': '人才检索', 'url': 'https://zteist.com/zh/people/' },
        { '@type': 'Service', 'name': '供求', 'serviceType': '供需对接', 'url': 'https://zteist.com/zh/market/' },
        { '@type': 'Service', 'name': '项目', 'serviceType': '项目合作', 'url': 'https://zteist.com/zh/projects/' },
        { '@type': 'Service', 'name': '背景调查', 'serviceType': '企业背景报告', 'url': 'https://zteist.com/zh/projects/' },
      ],
    })} />
  </head>
  <body class="bg-white min-h-screen text-gray-900 antialiased flex flex-col">
    <!-- Header：深藏青蓝底 + 翠青描边，只放 LOGO + 登录 + 语言 -->
    <header class="sticky top-0 z-20 bg-ink border-b border-jade/20">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <a href={lang === 'en' ? '/en/' : '/'} class="flex items-center">
          <span class="inline-flex items-center bg-white rounded-lg px-2.5 py-1 shadow-sm">
            <img src="/logo.png?v=2" alt={i.brand} class="h-8 w-auto" />
          </span>
        </a>
        <div class="flex items-center gap-3 text-sm text-paper">
          <AuthNav lang={lang} client:only="react" />
          <span class="text-paper/25">|</span>
          <div class="flex items-center gap-1 text-xs">
            <a href={zhHref} class={`px-2 py-1 rounded ${lang === 'zh' ? 'bg-jade text-ink' : 'text-paper/70 hover:text-paper'}`}>中文</a>
            <a href={enHref} class={`px-2 py-1 rounded ${lang === 'en' ? 'bg-jade text-ink' : 'text-paper/70 hover:text-paper'}`}>EN</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-6">
      <slot />
    </main>

    <!-- Footer：顶部橘色长条 + 深藏青蓝底 -->
    <footer>
      <div class="h-2 bg-zte-orange" aria-hidden="true"></div>
      <div class="bg-ink">
        <div class="mx-auto max-w-6xl px-4 py-8 text-xs text-muted">
          <nav class="mb-4 flex flex-wrap gap-x-5 gap-y-2">
            {footerLinks.map((l) => (
              <a href={l.href} class="hover:text-jade">{l.label}</a>
            ))}
          </nav>
          <p class="text-paper/60">© 2026 {i.brand} · {i.brandSub}</p>
        </div>
      </div>
    </footer>

    <!-- 小Z 对话框（全站；中英文首页不显示右下角浮标，避免与大图重复） -->
    <FloatingZ lang={lang} noFloating={path === '/' || path === '/en/'} client:only="react" />

    <InstallPwa lang={lang} />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {})
        })
      }
    </script>
  </body>
</html>
