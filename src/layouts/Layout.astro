---
import '../styles/global.css'
import { t, type Lang } from '../i18n'

interface Props {
  title: string
  lang?: Lang
}
const { title, lang = 'zh' } = Astro.props
const i = t(lang)
const prefix = lang === 'en' ? '/en' : '/zh'

const footerLinks = [
  { href: `${prefix}/about/`, label: i.about },
  { href: `${prefix}/join/`, label: i.join },
  { href: `${prefix}/privacy/`, label: i.privacy },
  { href: `${prefix}/terms/`, label: i.terms },
  { href: `${prefix}/faq/`, label: i.faq },
  { href: `${prefix}/contact/`, label: i.contact },
]

// 语言切换：有语言前缀的页换 /zh ↔ /en；根路径/邀请页切到对应语言的人员页
const path = Astro.url.pathname
const alt = (to: 'zh' | 'en') =>
  path.startsWith('/zh/') || path.startsWith('/en/')
    ? path.replace(/^\/(zh|en)/, '/' + to)
    : '/' + to + '/people/'
const zhHref = alt('zh')
const enHref = alt('en')
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#2B333F" />
  </head>
  <body class="bg-white min-h-screen text-gray-900 antialiased flex flex-col">
    <!-- Header：深蓝底 + 红描边，只放 LOGO + 登录 + 语言 -->
    <header class="sticky top-0 z-20 bg-zte-navy border-b-2 border-zte-red">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-2">
        <a href={`${prefix}/people/`} class="flex items-center">
          <img src="/logo.png?v=2" alt={i.brand} class="h-9 w-auto" />
        </a>
        <div class="flex items-center gap-3 text-sm text-white">
          <a href={`${prefix}/register/`} class="hover:text-zte-red">{i.login}</a>
          <span class="text-white/25">|</span>
          <div class="flex items-center gap-1 text-xs">
            <a href={zhHref} class={`px-2 py-1 rounded ${lang === 'zh' ? 'bg-zte-red text-white' : 'text-white/70 hover:text-white'}`}>中文</a>
            <a href={enHref} class={`px-2 py-1 rounded ${lang === 'en' ? 'bg-zte-red text-white' : 'text-white/70 hover:text-white'}`}>EN</a>
          </div>
        </div>
      </div>
    </header>

    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-6">
      <slot />
    </main>

    <!-- Footer：深蓝底 -->
    <footer class="bg-zte-navy">
      <div class="mx-auto max-w-6xl px-4 py-8 text-xs text-white/70">
        <nav class="mb-4 flex flex-wrap gap-x-5 gap-y-2">
          {footerLinks.map((l) => (
            <a href={l.href} class="hover:text-white">{l.label}</a>
          ))}
        </nav>
        <p>© 2026 {i.brand} · {i.brandSub}</p>
      </div>
    </footer>
  </body>
</html>
