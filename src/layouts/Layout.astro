---
import '../styles/global.css'
interface Props {
  title: string
  lang?: string
}
const { title, lang = 'zh' } = Astro.props
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-900 antialiased">
    <slot />
  </body>
</html>
