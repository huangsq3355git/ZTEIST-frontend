---
import '../styles/global.css'
import { t, type Lang } from '../i18n'

interface Props {
  title: string
  lang?: Lang
}
const { title, lang = 'zh' } = Astro.props
const i = t(lang)
const prefix = lang === 'en' ? '/en' : '/zh'

const nav = [
  { href: `${prefix}/people/`, label: i.people },
  { href: `${prefix}/market/`, label: i.supplyDemand },
  { href: `${prefix}/projects/`, label: i.projects },
]
const footerLinks = [
  { href: `${prefix}/about/`, label: i.about },
  { href: `${prefix}/join/`, label: i.join },
  { href: `${prefix}/privacy/`, label: i.privacy },
  { href: `${prefix}/terms/`, label: i.terms },
  { href: `${prefix}/faq/`, label: i.faq },
  { href: `${prefix}/contact/`, label: i.contact },
]

// 语言切换：把路径里的 /zh 或 /en 换成另一语言；无语言前缀的页回到语言根
const path = Astro.url.pathname
const alt = (to: 'zh' | 'en') =>
  path.startsWith('/zh/') || path.startsWith('/en/')
    ? path.replace(/^\/(zh|en)/, '/' + to)
    : '/' + to + '/'
const zhHref = alt('zh')
const enHref = alt('en')
---
<!doctype html>
<html lang={lang === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#008ED3" />
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-900 antialiased flex flex-col">
    <!-- Header -->
    <header class="sticky top-0 z-20 bg-white border-b border-gray-200">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <nav class="flex items-center gap-4 text-sm sm:gap-6">
          <a href={`${prefix}/people/`} class="flex items-center gap-2 font-bold text-zte-blue">
            <span class="inline-flex w-6 h-6 items-center justify-center rounded bg-zte-blue text-white text-xs font-bold">Z</span>
            <span>{i.brand}</span>
          </a>
          {nav.map((n) => (
            <a href={n.href} class="text-gray-600 hover:text-zte-blue">{n.label}</a>
          ))}
        </nav>
        <div class="flex items-center gap-3 text-sm">
          <a href={`${prefix}/register/`} class="text-zte-blue hover:opacity-80">{i.login}</a>
          <span class="text-gray-200">|</span>
          <div class="flex items-center gap-1 text-xs">
            <a href={zhHref} class={`px-2 py-1 rounded ${lang === 'zh' ? 'bg-zte-blue text-white' : 'text-gray-500 hover:text-zte-blue'}`}>中文</a>
            <a href={enHref} class={`px-2 py-1 rounded ${lang === 'en' ? 'bg-zte-blue text-white' : 'text-gray-500 hover:text-zte-blue'}`}>EN</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1 mx-auto w-full max-w-6xl px-4 py-6">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-12 bg-white border-t border-gray-200">
      <div class="mx-auto max-w-6xl px-4 py-8 text-xs text-gray-500">
        <nav class="mb-4 flex flex-wrap gap-x-5 gap-y-2">
          {footerLinks.map((l) => (
            <a href={l.href} class="hover:text-zte-blue">{l.label}</a>
          ))}
        </nav>
        <p>© 2026 {i.brand} · {i.brandSub}</p>
      </div>
    </footer>
  </body>
</html>
